{
  "name": "trackside",
  "version": "0.1.0",
  "private": true,
  "description": "A conference programme and run-of-show system",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "schema:extract": "sanity schema extract --enforce-required-fields",
    "types:generate": "sanity typegen generate",
    "migration:create": "sanity migration create",
    "migration:run": "sanity migration run"
  },
  "dependencies": {
    "@sanity/client": "^7.26.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.8.0",
    "next": "16.2.12",
    "next-sanity": "^13.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.8.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
