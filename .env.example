# Copy to .env.local and fill in. See docs/runbook.md sections 1 and 2.
#
# NEXT_PUBLIC_ values are inlined into the browser bundle by Next.js.
# Anything without that prefix is server-only. The prefix is the safeguard,
# so never add it to a token.

# --- Public: required ---------------------------------------------------
# The project ID from sanity.io/manage. Not a secret, and not a control:
# read access is bounded by dataset visibility alone. This dataset is public,
# so anyone holding this ID can query it directly over HTTP. CORS restricts
# browser origins only -- it does not restrict the API.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# The dataset to read. Public, so published content reads without a token.
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned API date. Changing it changes query behaviour, so it moves only as
# a deliberate, reviewed step.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-31


# --- Server-only: optional ----------------------------------------------
# Reading published content needs none of these. They are required only for
# the tasks noted against each.

# Role: viewer. Reads unpublished drafts for preview.
SANITY_API_READ_TOKEN=

# Role: editor. Seeding, dataset exports, and content migrations.
SANITY_API_WRITE_TOKEN=
